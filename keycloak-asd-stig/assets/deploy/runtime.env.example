# Keycloak ASD STIG - runtime configuration (identical for docker, podman, Kubernetes, Helm, systemd).
# Build-time options are already baked into the keycloak-stig image; everything here is runtime.
# Secrets: give *_FILE pointing at a mounted secret file (names ending PASSWORD/SECRET/USERNAME/TOKEN only).

# Hostnames (V-222574: admin console on its own hostname, reachable only from the admin network)
KC_HOSTNAME=https://sso.example.mil
KC_HOSTNAME_ADMIN=https://sso-admin.example.mil

# Server TLS (V-222596). Mounted from a secret; key file mode 0400/0440 (V-222551)
KC_HTTPS_CERTIFICATE_FILE=/run/secrets/tls/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/run/secrets/tls/tls.key

# DoD trust anchors + CRLs: shared volume filled by kcstig-tools pki-init / pki-refresh (V-222550, V-222553)
KC_TRUSTSTORE_PATHS=/opt/keycloak/conf/pki/truststore
# TLS client-auth (CAC) trust = ONLY the DoD anchors (V-222584). Without this, Keycloak also accepts client
# certificates from the ~140 public CAs of the JVM trust store (verified 26.8.2). The password only protects
# the integrity of a file of public certificates; it is not a secret.
KC_HTTPS_TRUST_STORE_FILE=/opt/keycloak/conf/pki/client-ca.p12
KC_HTTPS_TRUST_STORE_PASSWORD=dod-anchors

# Database over TLS with full verification (V-222596)
KC_DB_URL=jdbc:postgresql://db:5432/keycloak?sslmode=verify-full&sslrootcert=/run/secrets/db-ca/ca.crt
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD_FILE=/run/secrets/db_password

# First start only: temporary admin, deleted by the apply job (--remove-bootstrap-admin, V-222662).
# Restarting with these still set does NOT recreate it once the admin realm exists (verified 26.8.2).
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# Logs: JSON to stdout by default (collected by the platform). Add syslog only if your SIEM needs it:
# KC_LOG=console,syslog
# KC_LOG_SYSLOG_ENDPOINT=siem.example.mil:514
# KC_LOG_SYSLOG_PROTOCOL=tcp
# KC_LOG_SYSLOG_APP_NAME=keycloak-myapp

# Account-change notifications to SA/ISSO via realm SMTP (V-222417..V-222422)
# KC_SPI_EVENTS_LISTENER__STIG_AUDIT__NOTIFY_EMAILS=isso@example.mil,sa@example.mil

# Behind a TLS-terminating proxy that verified the CAC and forwards it (edge-verify mode, see references/cac-pki.md):
# KC_PROXY_HEADERS=xforwarded
# KC_SPI_X509CERT_LOOKUP__PROVIDER=nginx
# KC_SPI_X509CERT_LOOKUP__NGINX__SSL_CLIENT_CERT=ssl-client-cert
# KC_SPI_X509CERT_LOOKUP__NGINX__SSL_CERT_CHAIN_PREFIX=USELESS
# KC_SPI_X509CERT_LOOKUP__NGINX__CERTIFICATE_CHAIN_LENGTH=10
