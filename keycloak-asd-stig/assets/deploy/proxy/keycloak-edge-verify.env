# Add to runtime.env when a proxy verifies the CAC and forwards it (nginx-edge-verify.conf).
KC_PROXY_HEADERS=xforwarded
# provider=nginx is BUILD-time: build the image with --x509-lookup nginx (tag suffix -nginx)
KC_SPI_X509CERT_LOOKUP__NGINX__SSL_CLIENT_CERT=ssl-client-cert
KC_SPI_X509CERT_LOOKUP__NGINX__SSL_CERT_CHAIN_PREFIX=USELESS
KC_SPI_X509CERT_LOOKUP__NGINX__CERTIFICATE_CHAIN_LENGTH=10
# false: Keycloak rebuilds and validates the chain itself instead of trusting the proxy's verdict
KC_SPI_X509CERT_LOOKUP__NGINX__TRUST_PROXY_VERIFICATION=false
