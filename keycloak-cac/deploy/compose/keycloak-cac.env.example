# keycloak-cac runtime configuration (no secrets in this file: secrets are *_FILE mounts, see compose.yaml)
CAC_PUBLIC_URL=https://sso.example.mil
CAC_REALM=dod-cac
CAC_REALM_DISPLAY_NAME=DoD CAC Login
# upn (SAN principal name, DoD standard) | edipi (10-digit DoD ID from the CN) | cn | subject-dn
CAC_USERNAME_SOURCE=upn
# online (download DoD CRLs + OCSP) | file (air-gapped, see compose.airgap.yaml) | ocsp
CRL_MODE=online
# Alt Token administrators: username=<Alt Token UPN>, comma separated
CAC_ADMINS=smith.alex.adm=3456789012.alt@mil
# Card holders: username=<value of CAC_USERNAME_SOURCE>, or CAC_USERS_JSON / CAC_USERS_DIR for full records
CAC_USERS=doe.john=1234567890123456@mil
KC_DB_URL=jdbc:postgresql://db.example.mil:5432/keycloak?sslmode=verify-full
KC_DB_USERNAME=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap
# Behind a corporate egress proxy (CRL downloads): HTTPS_PROXY / HTTP_PROXY / NO_PROXY, CURL_CA_BUNDLE
