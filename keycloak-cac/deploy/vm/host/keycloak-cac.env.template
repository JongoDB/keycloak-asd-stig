# keycloak-cac runtime configuration for the VM deployment. NO SECRETS here: they are *_FILE mounts (compose.yaml).
# Rendered by setup-host.sh to /srv/idp/config/keycloak-cac.env (${PUBLIC_HOST}, ${ADMIN_HOST}, ${REALM} filled in).
CAC_PUBLIC_URL=https://${PUBLIC_HOST}
CAC_REALM=${REALM}
CAC_REALM_DISPLAY_NAME=${REALM_DISPLAY}
# Card holders are found by the 10-digit DoD ID at the end of the certificate CN (LAST.FIRST.MI.1234567890).
# The admin enters it on the user as "DoD ID number (EDIPI)" (attribute cac_edipi). Alt Tokens always map by UPN.
CAC_USERNAME_SOURCE=edipi
# Card, or password + TOTP for people without one. Microsoft Entra ID is a brokered provider (host/idp-admin.py entra).
CAC_AUTH_MODE=cac_or_mfa
# Production: DoD PKI baked into the image only; DoD CRLs downloaded and refreshed every 6 h, plus OCSP.
CRL_MODE=online
CAC_LAB_MODE=false
# OCSP fails CLOSED too: an unreachable DoD responder refuses a card sign-in rather than leaving revocation to the CRL
# alone. Check that ocsp.disa.mil answers from your network first (openssl ocsp against a current DoD ID CA).
CAC_OCSP_FAIL_OPEN=false
# Lockout (V-222432/V-222433, AC-7): 3 failures lock for 15 min, each further 3 adding 15 min up to 24 h, failures
# remembered for 24 h. Not permanent: anyone on the internet could otherwise lock any account - the sole
# administrator's included - until an administrator acts. Keycloak applies the lock to the card path too.
CAC_LOCKOUT=temporary
# Certificate policy OIDs: left empty on purpose (wrong OIDs lock everyone out); see keycloak-asd-stig/references.
CAC_CERT_POLICIES=
# Master (admin) realm: break-glass only. Day-to-day administration is this realm's console, by realm role.
# CAC_ADMINS names the master realm's Alt Token administrators; with no real Alt Token holder it names a placeholder
# whose UPN no card carries, which lets the image harden master (Alt Token-only browser flow, password grant denied,
# bootstrap admin deleted) while nobody can sign in to it. Recovery: `kc.sh bootstrap-admin service` (README, "Break-glass").
CAC_ADMINS=${CAC_ADMINS}
# Users are added in the admin console or with idp-admin.py (docs/vm-accounts.md), not here.
CAC_USERS=
CAC_CLIENTS_DIR=/clients
KC_DB_URL=jdbc:postgresql://db:5432/keycloak?sslmode=verify-full&sslrootcert=/run/secrets/db_ca
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD_FILE=/run/secrets/db_password
KC_HTTPS_CERTIFICATE_FILE=/run/secrets/tls_crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/run/secrets/tls_key
CAC_AUTOMATION_SECRET_FILE=/run/secrets/automation_secret
# What network clients may request (raw path; an entry ending in / is a prefix). Only this realm: master and any
# other realm are unreachable from the network. Within the realm only what sign-in, the broker, the account console
# and the admin console use - NOT /realms/${REALM}/clients-registrations (dynamic client registration bypasses the
# admin gate; no relying party uses it), which therefore answers 404. Add an EXACT path here only if a needed page is
# refused (the refusal is logged as STIG-PUBLIC-PATH-REFUSED).
STIG_PUBLIC_PATHS=/realms/${REALM},/realms/${REALM}/.well-known/,/realms/${REALM}/protocol/,/realms/${REALM}/login-actions/,/realms/${REALM}/broker/,/realms/${REALM}/account,/realms/${REALM}/account/,/admin/${REALM}/,/admin/realms/${REALM},/admin/realms/${REALM}/,/admin/serverinfo,/resources/
# The administrator allowlist is ENFORCED for this realm by configuration: if its master-realm allowlist is ever
# missing, every administrator is refused (fail closed) instead of the check switching off.
STIG_ALLOWLIST_ENFORCED_REALMS=${REALM}
# Card port (8444, published by compose.yaml): the present-card step posts there so the browser makes a fresh TLS
# handshake and offers the CAC.
STIG_CARD_PORT=8444
# Optional login theme of your own (setup-host.sh THEME_DIR + the commented volume in compose.yaml, parent dod-stig).
# kcstig applies banner.theme to BOTH this realm and the master realm at every start. Without it: dod-stig.
#CAC_PROFILE_JSON={"banner":{"theme":"<THEME>"}}
